# Parquet files are large and binary - regenerate from generate.py
fixtures/**/*.parquet

# Keep manifest.json files (small, useful for CI verification)
!fixtures/**/manifest.json

# DuckDB databases
*.db
*.duckdb

# Packaged fixtures (build artifact)
demo-fixtures/
demo-fixtures.tar.gz

# Allow demo notebook (overrides root .gitignore)
!demo_notebook.ipynb
