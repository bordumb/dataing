# syntax=docker/dockerfile:1
# Dataing Backend Dockerfile
# Multi-stage build for API server and Temporal worker

# =============================================================================
# Stage 1: Builder - Install dependencies
# =============================================================================
FROM python:3.11-slim AS builder

# Install build dependencies
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /build

# Copy all necessary files for dependency resolution
COPY pyproject.toml uv.lock ./
COPY python-packages/dataing/ python-packages/dataing/
COPY python-packages/dataing-ee/ python-packages/dataing-ee/

# Create virtual environment and install dependencies
RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install the main package (not editable for production), pinning every
# dependency to its uv.lock version so the image runs what the tests run
RUN uv export --frozen --no-dev --no-emit-project --no-hashes --quiet -o /tmp/constraints.txt \
    && uv pip install --no-cache -c /tmp/constraints.txt ./python-packages/dataing

# =============================================================================
# Stage 2: Runtime - Lean production image
# =============================================================================
FROM python:3.11-slim AS runtime

# Labels for container metadata
LABEL org.opencontainers.image.title="Dataing Backend"
LABEL org.opencontainers.image.description="Autonomous Data Quality Investigation - API Server and Worker"
LABEL org.opencontainers.image.source="https://github.com/bordumb/dataing"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Install runtime dependencies only
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security
RUN groupadd --gid 1000 dataing \
    && useradd --uid 1000 --gid dataing --shell /bin/bash --create-home dataing

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Copy migrations
COPY --chown=dataing:dataing python-packages/dataing/migrations /app/migrations

# Switch to non-root user (numeric, so runtimes can verify it isn't root)
USER 1000:1000

# Expose API port
EXPOSE 8000

# Health check for API server
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["curl", "-f", "http://localhost:8000/health"]

# Default command: start API server
# Override with: docker run ... python -m dataing.entrypoints.temporal_worker
CMD ["uvicorn", "dataing.entrypoints.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
