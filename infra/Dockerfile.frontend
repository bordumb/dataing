# syntax=docker/dockerfile:1
# Dataing Frontend Dockerfile
# Multi-stage build: Vite build + nginx

# =============================================================================
# Stage 1: Builder - Build static assets
# =============================================================================
FROM node:20-alpine AS builder

WORKDIR /build

# Copy package files first for better caching
COPY frontend/app/package.json frontend/app/pnpm-lock.yaml ./

# Install the pnpm version pinned by packageManager in package.json
RUN corepack enable && corepack install

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY frontend/app/ ./

# Build production assets
RUN pnpm build

# =============================================================================
# Stage 2: Runtime - Serve with nginx
# =============================================================================
FROM nginx:alpine AS runtime

# Labels for container metadata
LABEL org.opencontainers.image.title="Dataing Frontend"
LABEL org.opencontainers.image.description="Autonomous Data Quality Investigation - Web UI"
LABEL org.opencontainers.image.source="https://github.com/bordumb/dataing"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Copy custom nginx configuration
COPY infra/nginx.conf /etc/nginx/templates/default.conf.template

# Copy built assets from builder
COPY --from=builder /build/dist /usr/share/nginx/html

# Set default API URL (can be overridden at runtime)
ENV API_URL=http://api:8000

# Expose port 3000
EXPOSE 3000

# Use envsubst to template nginx config at startup
CMD ["sh", "-c", "envsubst '$$API_URL' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
